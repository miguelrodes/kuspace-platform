generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EventStatus {
  draft
  upcoming
  live
  past
  cancelled
}

enum AdmissionMode {
  public
  curated
}

enum EventDisplayMode {
  event
  room
}

enum EventType {
  room
  terrace
  festival
  warehouse
}

enum LineupEntryKind {
  main
  opener
  special_guest
  resident
}

enum EventAccessAssignmentSource {
  purchase
  manual
  approval
}

enum EventAccessPaymentState {
  not_required
  pending
  paid
  waived
}

enum EventApplicationStatus {
  pending
  accepted
  denied
}

enum GuestlistEntrySource {
  user
  manual
}

enum TicketTierVisibility {
  public
  hidden
}

enum TicketSectionVisibility {
  public
  hidden
  restricted
}

enum TicketTierStatus {
  live
  upcoming
  sold_out
}

enum TicketReleaseMode {
  manual
  scheduled
  after_previous_sold_out
}

enum RecruiterType {
  nightclub
  label
}

enum ConsumerTicketStatus {
  active
  inactive
  scanned
}

enum ProfileVisibility {
  public
  private
}

/// Recruiter profiles follow the current app model:
/// recruiterType is the only recruiter classification field.
/// Legacy promoter/kind concepts are intentionally not part of persistence.
model RecruiterProfile {
  id                  String                  @id @default(uuid())
  slug                String                  @unique
  recruiterType       RecruiterType
  realName            String?
  displayName         String
  avatarImageUrl      String?
  bannerImageUrl      String?
  bio                 String?
  locationDisplayText String?
  canFollow           Boolean?
  instagram           String?
  soundcloud          String?
  spotify             String?
  residentAdvisor     String?
  website             String?
  email               String?
  mapsLocation        String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  stats               RecruiterProfileStats?
  soundProfile        RecruiterSoundProfile?
  events              Event[]
  labels              EventLabel[]            @relation("LabelRecruiterProfile")

  @@index([recruiterType])
  @@map("recruiter_profiles")
}

model RecruiterProfileStats {
  recruiterProfileId  String           @id
  eventsHeld          Int?
  citiesActive        Int?
  followers           Int?
  publicRating        Float?
  displayEventsHeld   Boolean          @default(true)
  displayCitiesActive Boolean          @default(true)
  displayFollowers    Boolean          @default(true)
  displayPublicRating Boolean          @default(true)
  recruiterProfile    RecruiterProfile @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)

  @@map("recruiter_profile_stats")
}

model RecruiterSoundProfile {
  id                String                       @id @default(uuid())
  recruiterProfileId String                      @unique
  roomSize          Int?
  roomCount         Int?
  recruiterProfile  RecruiterProfile             @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)
  genres            RecruiterSoundProfileGenre[]
  rooms             RecruiterSoundProfileRoom[]

  @@map("recruiter_sound_profiles")
}

model RecruiterSoundProfileGenre {
  id                    String                @id @default(uuid())
  recruiterSoundProfileId String
  value                 String
  sortOrder             Int
  recruiterSoundProfile RecruiterSoundProfile @relation(fields: [recruiterSoundProfileId], references: [id], onDelete: Cascade)

  @@unique([recruiterSoundProfileId, sortOrder])
  @@map("recruiter_sound_profile_genres")
}

model RecruiterSoundProfileRoom {
  id                    String                @id @default(uuid())
  recruiterSoundProfileId String
  name                  String
  capacity              Int
  sortOrder             Int
  recruiterSoundProfile RecruiterSoundProfile @relation(fields: [recruiterSoundProfileId], references: [id], onDelete: Cascade)

  @@unique([recruiterSoundProfileId, sortOrder])
  @@map("recruiter_sound_profile_rooms")
}

model ConsumerUser {
  id                     String                       @id @default(uuid())
  username               String                       @unique
  firstName              String
  lastName               String
  email                  String                       @unique
  phoneNumber            String?
  avatarImageUrl         String?
  city                   String?
  birthdate              DateTime?
  profileVisibility      ProfileVisibility?
  notificationsEnabled   Boolean?
  createdAt              DateTime                     @default(now())
  favoriteGenres         ConsumerUserFavoriteGenre[]
  savedEvents            ConsumerUserSavedEvent[]
  upcomingTicketEvents   ConsumerUserUpcomingTicketEvent[]
  pastTicketEvents       ConsumerUserPastTicketEvent[]
  ticketWalletEntries    ConsumerTicketWalletEntry[]
  eventAccessAssignments EventAccessAssignment[]
  eventApplications      EventApplication[]
  guestlistEntries       GuestlistEntry[]

  @@map("consumer_users")
}

model ConsumerUserFavoriteGenre {
  id             String       @id @default(uuid())
  consumerUserId String
  value          String
  sortOrder      Int
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)

  @@unique([consumerUserId, sortOrder])
  @@map("consumer_user_favorite_genres")
}

model ConsumerUserSavedEvent {
  id             String       @id @default(uuid())
  consumerUserId String
  eventSlug      String
  createdAt      DateTime     @default(now())
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventSlug], references: [slug], onDelete: Cascade)

  @@unique([consumerUserId, eventSlug])
  @@map("consumer_user_saved_events")
}

model ConsumerUserUpcomingTicketEvent {
  id             String       @id @default(uuid())
  consumerUserId String
  eventSlug      String
  createdAt      DateTime     @default(now())
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventSlug], references: [slug], onDelete: Cascade)

  @@unique([consumerUserId, eventSlug])
  @@map("consumer_user_upcoming_ticket_events")
}

model ConsumerUserPastTicketEvent {
  id             String       @id @default(uuid())
  consumerUserId String
  eventSlug      String
  createdAt      DateTime     @default(now())
  consumerUser   ConsumerUser @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventSlug], references: [slug], onDelete: Cascade)

  @@unique([consumerUserId, eventSlug])
  @@map("consumer_user_past_ticket_events")
}

/// Wallet entries preserve explicitly stored consumer ticket status.
/// If status is null, app code may derive a fallback from access assignment state.
model ConsumerTicketWalletEntry {
  id            String               @id @default(uuid())
  consumerUserId String
  eventSlug     String
  accessGroupId String
  quantity      Int
  ticketLabel   String?
  status        ConsumerTicketStatus?
  createdAt     DateTime             @default(now())
  consumerUser  ConsumerUser         @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  event         Event                @relation(fields: [eventSlug], references: [slug], onDelete: Cascade)
  accessGroup   AccessGroup          @relation(fields: [accessGroupId], references: [id], onDelete: Restrict)

  @@index([consumerUserId, eventSlug])
  @@map("consumer_ticket_wallet_entries")
}

/// Event is the aggregate root.
/// Section data is persisted in normalized related tables rather than a single event blob:
/// cover fields live directly on Event, while lineup, timetable, guestlist,
/// access assignments, applications, budget, tickets, and labels live in
/// dedicated child/link tables.
model Event {
  id                String                    @id @default(uuid())
  slug              String                    @unique
  status            EventStatus
  admissionMode     AdmissionMode
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  recruiterProfileId String
  /// Cover fields persisted directly on Event.
  title             String
  description       String?
  shortDescription  String?
  /// Supports event-level genres or room-level genres.
  genreDisplayMode  EventDisplayMode?
  /// Top-level lineup section display mode from the current app model.
  lineupDisplayMode EventDisplayMode?
  date              DateTime
  /// Cover time range is stored as separate start/end values for now.
  timeStart         String?
  timeEnd           String?
  /// Timetable section-level global range, kept separate from cover time.
  timetableStartTime String?
  timetableEndTime   String?
  imageUrl          String
  imageAlt          String
  location          String
  venue             String
  capacityTarget    Int
  eventType         EventType
  roomSize          Int
  numberOfRooms     Int?
  /// Event budget section headline value. Derived UI metrics like paid,
  /// unpaid, remaining, and totals should still come from BudgetItem rows.
  totalBudget       Decimal                   @default(0) @db.Decimal(12, 2)
  recruiterProfile  RecruiterProfile          @relation(fields: [recruiterProfileId], references: [id], onDelete: Cascade)
  genres            EventGenre[]
  rooms             EventRoom[]
  lineupEntries     LineupEntry[]
  timetableRows     TimetableRow[]
  accessGroups      AccessGroup[]
  accessAssignments EventAccessAssignment[]
  applications      EventApplication[]
  guestlistEntries  GuestlistEntry[]
  budgetItems       BudgetItem[]
  ticketSections    TicketSection[]
  labelLinks        EventLabelLink[]
  savedByUsers      ConsumerUserSavedEvent[]
  upcomingTicketUsers ConsumerUserUpcomingTicketEvent[]
  pastTicketUsers   ConsumerUserPastTicketEvent[]
  walletEntries     ConsumerTicketWalletEntry[]

  @@index([status])
  @@index([admissionMode])
  @@index([recruiterProfileId, status])
  @@index([admissionMode, status])
  @@index([recruiterProfileId])
  @@index([date])
  @@index([slug, status])
  @@map("events")
}

model EventGenre {
  id        String @id @default(uuid())
  eventId   String
  value     String
  sortOrder Int
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@map("event_genres")
}

model EventRoom {
  id        String           @id @default(uuid())
  eventId   String
  /// Stable UI/migration key from the current client model.
  clientKey String?
  name      String
  capacity  Int
  sortOrder Int
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  genres    EventRoomGenre[]
  lineupRooms LineupEntryRoom[]
  timetableRows TimetableRow[]

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@index([clientKey])
  @@map("event_rooms")
}

/// Room-level genres for Event.cover.rooms[].genres when genreDisplayMode is "room".
model EventRoomGenre {
  id          String    @id @default(uuid())
  eventRoomId String
  value       String
  sortOrder   Int
  eventRoom   EventRoom @relation(fields: [eventRoomId], references: [id], onDelete: Cascade)

  @@unique([eventRoomId, sortOrder])
  @@index([eventRoomId])
  @@map("event_room_genres")
}

model LineupEntry {
  id        String            @id @default(uuid())
  eventId   String
  /// Stable UI/migration key from the current client model.
  clientKey String?
  artistId  String
  name      String
  kind      LineupEntryKind?
  sortOrder Int
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomLinks LineupEntryRoom[]
  timetableRows TimetableRow[]

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@index([artistId])
  @@index([clientKey])
  @@map("event_lineup_entries")
}

/// Join table so one lineup entry can belong to multiple rooms.
/// This preserves current app support for roomId and roomIds without assuming
/// a single-room lineup model in persistence.
model LineupEntryRoom {
  lineupEntryId String
  eventRoomId   String
  lineupEntry   LineupEntry @relation(fields: [lineupEntryId], references: [id], onDelete: Cascade)
  eventRoom     EventRoom   @relation(fields: [eventRoomId], references: [id], onDelete: Cascade)

  @@id([lineupEntryId, eventRoomId])
  @@index([eventRoomId])
  @@map("event_lineup_entry_rooms")
}

model TimetableRow {
  id            String      @id @default(uuid())
  eventId       String
  /// Stable UI/migration key from the current client model.
  clientKey     String?
  title         String
  lineupEntryId String?
  eventRoomId   String?
  /// Optional fallback room label from the current client model.
  roomName      String?
  notes         String?
  startTime     String
  endTime       String
  sortOrder     Int
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lineupEntry   LineupEntry? @relation(fields: [lineupEntryId], references: [id], onDelete: SetNull)
  eventRoom     EventRoom?   @relation(fields: [eventRoomId], references: [id], onDelete: SetNull)

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@index([eventRoomId])
  @@index([lineupEntryId])
  @@index([clientKey])
  @@map("event_timetable_rows")
}

/// Event-scoped access groups are the canonical replacement for the old
/// guestlist-group concept. UI copy may still say "Guestlist" in places,
/// but persistence and access logic should use access-group semantics.
model AccessGroup {
  id                String                    @id @default(uuid())
  eventId           String
  clientKey         String?
  name              String
  sortOrder         Int
  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accessAssignments EventAccessAssignment[]
  applications      EventApplication[]
  guestlistEntries  GuestlistEntry[]
  ticketSections    TicketSection[]
  allowedInSections TicketSectionAllowedGroup[]
  walletEntries     ConsumerTicketWalletEntry[]

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@map("event_access_groups")
}

/// Event access assignments are the source-of-truth access record for a user
/// within an event. In practice there is one assignment per user per event.
/// QR activity is derived from paymentState, and checkedIn implies a scanned
/// consumer ticket state in downstream app logic.
model EventAccessAssignment {
  id            String                       @id @default(uuid())
  eventId       String
  consumerUserId String
  accessGroupId String
  source        EventAccessAssignmentSource
  paymentState  EventAccessPaymentState
  checkedIn     Boolean
  assignedAt    DateTime?
  assignedBy    String?
  notes         String?
  event         Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumerUser  ConsumerUser                 @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  accessGroup   AccessGroup                  @relation(fields: [accessGroupId], references: [id], onDelete: Restrict)

  @@unique([eventId, consumerUserId])
  @@index([eventId])
  @@index([consumerUserId])
  @@index([accessGroupId])
  @@map("event_access_assignments")
}

/// Curated-event applications are persisted separately from access assignments.
/// Only curated events should use this model. Accepted applications can then
/// lead to an EventAccessAssignment, but the application record remains distinct.
model EventApplication {
  id            String                 @id @default(uuid())
  eventId       String
  consumerUserId String
  status        EventApplicationStatus
  appliedAt     DateTime
  reviewedAt    DateTime?
  reviewedBy    String?
  accessGroupId String?
  notes         String?
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumerUser  ConsumerUser           @relation(fields: [consumerUserId], references: [id], onDelete: Cascade)
  accessGroup   AccessGroup?           @relation(fields: [accessGroupId], references: [id], onDelete: SetNull)

  @@unique([eventId, consumerUserId])
  @@index([eventId])
  @@index([consumerUserId])
  @@index([accessGroupId])
  @@map("event_applications")
}

/// Guestlist entries remain a separate operational layer for recruiter workflows.
/// They should not replace EventAccessAssignment as the access/payment source of truth.
/// User entries can point to a consumer user, while manual entries can store names
/// directly and optionally resolve to a user later.
model GuestlistEntry {
  id            String              @id @default(uuid())
  eventId       String
  source        GuestlistEntrySource
  accessGroupId String
  consumerUserId String?
  firstName     String?
  lastName      String?
  checkedIn     Boolean
  createdAt     DateTime            @default(now())
  notes         String?
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accessGroup   AccessGroup         @relation(fields: [accessGroupId], references: [id], onDelete: Restrict)
  consumerUser  ConsumerUser?       @relation(fields: [consumerUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([accessGroupId])
  @@index([consumerUserId])
  @@map("event_guestlist_entries")
}

/// Budget items are the canonical line-level budget records for an event.
/// UI totals should be derived from these rows rather than stored redundantly,
/// unless a later caching layer is intentionally introduced.
model BudgetItem {
  id        String  @id @default(uuid())
  eventId   String
  /// Stable UI/migration key from the current client model.
  clientKey String?
  category  String
  title     String
  amount    Decimal @db.Decimal(12, 2)
  paid      Boolean
  notes     String?
  sortOrder Int
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@map("event_budget_items")
}

/// Ticket sections follow the current code model exactly.
/// accessGroupId is the group this section belongs to and that purchase assigns into.
/// allowedGroups is only meaningful for restricted visibility and controls who can
/// see the section.
model TicketSection {
  id                String                    @id @default(uuid())
  eventId           String
  clientKey         String?
  name              String
  visibility        TicketSectionVisibility
  accessGroupId     String
  sortOrder         Int
  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accessGroup       AccessGroup               @relation(fields: [accessGroupId], references: [id], onDelete: Restrict)
  allowedGroups     TicketSectionAllowedGroup[]
  phases            TicketTier[]

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@index([accessGroupId])
  @@map("event_ticket_sections")
}

/// Normalized join table for TicketSection.allowedGroupIds.
model TicketSectionAllowedGroup {
  ticketSectionId String
  accessGroupId   String
  ticketSection   TicketSection @relation(fields: [ticketSectionId], references: [id], onDelete: Cascade)
  accessGroup     AccessGroup   @relation(fields: [accessGroupId], references: [id], onDelete: Cascade)

  @@id([ticketSectionId, accessGroupId])
  @@index([accessGroupId])
  @@map("event_ticket_section_allowed_groups")
}

/// Canonical ticket persistence is section-based:
/// Event -> TicketSection -> TicketTier.
/// The legacy top-level event.tickets.tiers array remains an app compatibility layer only.
/// Sold-out phases remain persisted rather than being deleted.
/// Release scheduling and chained release behavior are modeled via salesStart,
/// salesEnd, releaseMode, and releaseAfterTierId.
model TicketTier {
  id                 String               @id @default(uuid())
  ticketSectionId    String
  /// Stable UI/migration key from the current client model.
  clientKey          String?
  name               String
  price              Decimal              @db.Decimal(12, 2)
  quantityAvailable  Int
  quantitySold       Int                  @default(0)
  visibility         TicketTierVisibility
  status             TicketTierStatus
  sortOrder          Int
  salesStart         DateTime?
  salesEnd           DateTime?
  releaseMode        TicketReleaseMode?
  releaseAfterTierId String?
  ticketSection      TicketSection        @relation(fields: [ticketSectionId], references: [id], onDelete: Cascade)
  releaseAfterTier   TicketTier?          @relation("TicketTierReleaseChain", fields: [releaseAfterTierId], references: [id], onDelete: SetNull)
  releasesNext       TicketTier[]         @relation("TicketTierReleaseChain")

  @@unique([ticketSectionId, sortOrder])
  @@index([ticketSectionId])
  @@index([releaseAfterTierId])
  @@index([clientKey])
  @@index([status])
  @@map("event_ticket_tiers")
}

/// Event labels are normalized separately from Event so one event can attach
/// multiple label identities. A label can optionally resolve to a recruiter
/// profile, which keeps event pages clickable without forcing label data into
/// the Event row itself.
model EventLabel {
  id                 String            @id @default(uuid())
  name               String
  profileSlug        String?
  avatarImageUrl     String?
  recruiterProfileId String?
  recruiterProfile   RecruiterProfile? @relation("LabelRecruiterProfile", fields: [recruiterProfileId], references: [id], onDelete: SetNull)
  eventLinks         EventLabelLink[]

  @@index([name])
  @@index([recruiterProfileId])
  @@index([profileSlug])
  @@map("event_labels")
}

/// Event-to-label attachment join table so events can have multiple labels
/// while preserving ordering on the public event page.
model EventLabelLink {
  eventId    String
  eventLabelId String
  sortOrder  Int
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventLabel EventLabel @relation(fields: [eventLabelId], references: [id], onDelete: Cascade)

  @@id([eventId, eventLabelId])
  @@unique([eventId, sortOrder])
  @@index([eventLabelId])
  @@map("event_label_links")
}
